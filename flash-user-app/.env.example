# Copy this file to .env and fill in real values before running the app.
# Ask the project owner for the real values — do not commit .env (it's gitignored).

# Sentry error monitoring DSN (safe to share within the team; write-only ingest endpoint)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog product analytics — project API key and ingest host (safe to
# share within the team; write-only). Leave blank until Vuyo creates the
# PostHog account and provides a real key — services/analytics.js no-ops
# with no events sent when this is unset, same pattern as Sentry above.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Backend API base URL. Points at the live production backend by default —
# most collaborators should leave this as-is unless running the backend locally.
EXPO_PUBLIC_API_BASE_URL=https://flash-app-hplc.onrender.com

# Google Sign-In OAuth client IDs (from Google Cloud Console, this project)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
