# ─── Flash Root .gitignore ─────────────────────────────────────────────────
# This file goes in the ROOT of the repo (same folder as docker-compose.yml).

# ── Secrets (NEVER commit these) ───────────────────────────────────────────
backend/.env
flash-user-app/.env
flash-driver-app/.env
# Root .env — read automatically by `docker compose` for Postgres/Redis
# credentials (see .env.example at repo root). Distinct from backend/.env.
/.env

# ── Node modules ─────────────────────────────────────────────────────────
node_modules/
*/node_modules/

# ── Expo & React Native build artifacts ───────────────────────────────────
flash-user-app/.expo/
flash-driver-app/.expo/
flash-user-app/android/
flash-user-app/ios/
flash-driver-app/android/
flash-driver-app/ios/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ── Build output ──────────────────────────────────────────────────────────
dist/
build/

# ── flash-store-portal ──────────────────────────────────────────────────────
# Real source lives on the separate admin-platform branch, not here. What
# shows up here is stray local build clutter (a dist/ build, node_modules/,
# and a .env with only a non-secret local API base URL) from local testing —
# ignored wholesale so it can never be accidentally committed, .env included.
flash-store-portal/