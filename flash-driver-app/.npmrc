# expo-router is pinned to ~4.0.17, which predates this project's Expo SDK 56
# upgrade — its peer dependencies (expo-constants@~17.0.8, @react-navigation
# packages at v7) conflict with the SDK 56 / React Navigation v6 versions
# the rest of this project actually uses. legacy-peer-deps=true is a
# workaround so `npm install` succeeds (locally and on EAS's remote build
# servers, which run their own fresh install from this committed config) —
# it is NOT a fix. The real fix is a deliberate, tested upgrade of
# expo-router + @react-navigation to SDK-56-compatible versions.
legacy-peer-deps=true
