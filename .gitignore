# ─── Flash Root .gitignore ─────────────────────────────────────────────────
# This file goes in the ROOT of the repo (same folder as docker-compose.yml).

# ── Secrets (NEVER commit these) ───────────────────────────────────────────
backend/.env
flash-user-app/.env
flash-driver-app/.env
# Store portal env (only the public API URL today); never committable.
flash-store-portal/.env
# Root .env — read automatically by `docker compose` for Postgres/Redis
# credentials (see .env.example at repo root). Distinct from backend/.env.
/.env

# ── Node modules ─────────────────────────────────────────────────────────
node_modules/
*/node_modules/

# ── Expo & React Native build artifacts ───────────────────────────────────
flash-user-app/.expo/
flash-driver-app/.expo/
flash-user-app/android/
flash-user-app/ios/
flash-driver-app/android/
flash-driver-app/ios/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
logs/
backend/logs/

# ── Build output ──────────────────────────────────────────────────────────
dist/
build/
# Schema-baseline inputs produced by the founder from production (never commit raw)
schema-baseline-input/
scripts/schema-baseline/.schema-check-tmp/
scripts/schema-baseline/.v43-rehearsal-tmp/
scripts/schema-baseline/.v44-rehearsal-tmp/
scripts/schema-baseline/.v45-rehearsal-tmp/

# Founder-held security reports: kept outside the repo, never committed
SECURITY_SELF_PENTEST_REPORT*.md
