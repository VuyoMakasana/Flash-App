# ═══════════════════════════════════════════════════════════════════
# Flash Backend — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file:  cp .env.example .env
# Fill in every value before starting the server.
# NEVER commit the filled-in .env file to git.
# ═══════════════════════════════════════════════════════════════════

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# production | development | test

# Structured (pino) log level. Optional — defaults to "debug" in development,
# "info" in production, and "silent" during tests if unset.
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (URI)
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
# NEVER point this at the real production project from a local/dev environment --
# config/database.js refuses to start if DATABASE_URL matches the known production
# project ref and this process isn't genuinely running on Render (RENDER=true, set
# automatically there, never by hand). Use a separate dev/staging Supabase project
# here instead. The only legitimate way around the guard is
# I_UNDERSTAND_THIS_CONNECTS_TO_PRODUCTION=true, for a deliberate one-off script --
# not something to set as a standing default.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connection pool size. This project is confirmed on Supabase's free tier
# (max 60 connections platform-wide, shared with Supabase's own internal use
# and any concurrent dashboard/migration session) -- 30 (config/database.js's
# own default when this var is unset) keeps real headroom under that cap.
# Only raise this alongside confirming real headroom still exists, and never
# run more than one backend instance without first re-checking this math --
# each instance opens its own pool.
DB_POOL_MAX=30

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate a secure secret:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 64 hex characters. Changing this invalidates ALL existing tokens.
JWT_SECRET=CHANGE_ME_generate_with_command_above
JWT_EXPIRES_IN=15m

# ─── PAYMENT METHOD ENCRYPTION ───────────────────────────────────────────────
# MUST be independent of JWT_SECRET. If JWT_SECRET rotates, stored card
# authorization codes must remain decryptable — that requires a SEPARATE key.
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_METHOD_ENCRYPTION_KEY=CHANGE_ME_generate_independently_of_jwt_secret

# ─── CASH OTP ─────────────────────────────────────────────────────────────────
# MUST be independent of JWT_SECRET — verifies the one-time codes customers
# give drivers to confirm cash-on-delivery collection. Required in production;
# the first cash-OTP request throws if unset (see src/services/cashOtpService.js).
# Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CASH_OTP_SECRET=CHANGE_ME_generate_independently_of_jwt_secret

# ─── PAYSTACK ────────────────────────────────────────────────────────────────
# Test keys:  dashboard.paystack.com → Settings → API Keys & Webhooks
# Live keys:  switch sk_test_ → sk_live_ and set NODE_ENV=production
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# ─── GOOGLE OAUTH (Sign In) ───────────────────────────────────────────────────
# console.cloud.google.com → Create credentials → OAuth 2.0 Client ID
# Create separate credentials for: Android (user app), iOS (user app),
#   Android (driver app), iOS (driver app)
GOOGLE_CLIENT_ID_USER_ANDROID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_USER_IOS=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_DRIVER_ANDROID=YOUR_DRIVER_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_DRIVER_IOS=YOUR_DRIVER_IOS_CLIENT_ID.apps.googleusercontent.com

# ─── APPLE SIGN IN ───────────────────────────────────────────────────────────
# developer.apple.com → Certificates, IDs & Profiles → Identifiers
# Must match bundle IDs in app.json exactly.
APPLE_CLIENT_ID=co.za.flash.userapp
APPLE_DRIVER_CLIENT_ID=co.za.flash.driverapp

# ─── GOOGLE MAPS ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# RESTRICT this key in Google Cloud Console to:
#   - Android package names: co.za.flash.userapp, co.za.flash.driverapp
#   - iOS bundle IDs: co.za.flash.userapp, co.za.flash.driverapp
#   - Specific SHA-1 fingerprints for your keystores
# An unrestricted Maps key can be abused by anyone who decompiles the APK.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─── ADMIN ───────────────────────────────────────────────────────────────────
# ADMIN_EMAIL/ADMIN_PASSWORD_HASH below are legacy — real admin accounts live
# in the `admins` table (migrate.js v18+), individually created, not this
# single shared credential. Kept only because some older code/docs still
# reference the names; not read by the live admin login path.
ADMIN_EMAIL=admin@YOUR_DOMAIN.com
# Generate hash:
#   node -e "require('bcryptjs').hash('YOUR_STRONG_PASSWORD_MIN_16_CHARS', 12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_ADMIN_PASSWORD

# Signs both the JSON API's admin JWTs (/api/admin/login) AND — see
# ADMIN_SESSION_SECRET below — used as a fallback for the AdminJS panel's own
# session cookie if that's not set. MUST be independent of JWT_SECRET (same
# reasoning as PAYMENT_METHOD_ENCRYPTION_KEY above: rotating one must never
# silently affect the other).
ADMIN_JWT_SECRET=CHANGE_ME_generate_with_command_above
# Optional. Signs the AdminJS server-rendered panel's own session cookie
# (a separate mechanism from the JSON API's bearer JWT above — see
# adminPanel.js). Falls back to ADMIN_JWT_SECRET when unset so no existing
# deployment needs a config change, but setting this independently means a
# leaked session-cookie secret can't be used to forge JSON API tokens, or
# vice versa. Admin Platform Phase 2.
ADMIN_SESSION_SECRET=CHANGE_ME_generate_with_command_above

# Admin Platform Phase 3 — signs Store Admin Portal JWTs (/api/store-auth/*).
# A third, fully disjoint secret domain: never JWT_SECRET, never
# ADMIN_JWT_SECRET/ADMIN_SESSION_SECRET. A leaked store-account token must
# never be usable to forge a user/driver/admin token or vice versa.
STORE_JWT_SECRET=CHANGE_ME_generate_with_command_above

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Required for Socket.IO horizontal scaling (multiple server instances).
# Free option: upstash.com → Create Redis database → copy the Redis URL.
# Set to "disabled" for single-instance development (no horizontal scale).
REDIS_URL=disabled
# REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Mobile apps bypass CORS.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── APP URL ─────────────────────────────────────────────────────────────────
# Your deployed backend URL. Used for Paystack callback redirects.
APP_URL=https://your-backend-domain.onrender.com

# ─── CLOUDINARY ──────────────────────────────────────────────────────────────
# cloudinary.com → Dashboard → copy Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ─── EMAIL / SMTP ────────────────────────────────────────────────────────────
# Required for email verification and password reset.
# Resend.com (recommended): resend.com → API Keys → Create Key
# Gmail alternative: Account → Security → App Passwords
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=YOUR_SMTP_PASSWORD_OR_API_KEY
EMAIL_FROM=Flash <noreply@YOUR_DOMAIN.com>

# ─── SENTRY ──────────────────────────────────────────────────────────────────
# sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# ─── TEMPORARY TEST MODE — remove before real launch ──────────────────────────
# When "true", a brand-new driver registration (signup only — never applies
# to an existing account logging in later) starts pre-approved with
# placeholder documents and a real, unpaid 30-day subscription, so a real
# tester can go online and accept orders immediately with no manual setup.
# See backend/src/models/Driver.js's Driver.create() and
# backend/src/services/subscriptionService.js for the exact mechanism.
# Unset (or set to anything other than "true") before going live.
DRIVER_TEST_MODE=false
