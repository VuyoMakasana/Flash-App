# backend/.env.test.example: test-only environment (L0.1, #69)
#
# Copy to backend/.env.test (git-ignored) and fill in the one real value:
#   PAYSTACK_SECRET_KEY: your Paystack TEST secret key (sk_test_...).
#
# tests/setup/testEnv.js loads this file before every test run and REFUSES
# to run if DATABASE_URL is not localhost/127.0.0.1/::1, or if any Paystack
# key is a live key (sk_live_/pk_live_). Variables already set in your shell
# or in CI take precedence over this file.
#
# NEVER put production values here. Production secrets live only in Render.

NODE_ENV=test

# Local throwaway Postgres 17 from docker-compose.test.yml (127.0.0.1:55432).
DATABASE_URL=postgresql://flash_test:flash_test@127.0.0.1:55432/flash_test

# Test-only placeholders (not real secrets; match CI).
JWT_SECRET=local_test_jwt_secret_not_real_do_not_use_in_prod
STORE_JWT_SECRET=local_test_store_jwt_secret_not_real
ADMIN_JWT_SECRET=local_test_admin_jwt_secret_not_real
PAYMENT_METHOD_ENCRYPTION_KEY=local_test_payment_method_key_not_real_32chars
CASH_OTP_SECRET=local_test_cash_otp_secret_not_real
REDIS_URL=disabled
PORT=3001

# Paystack TEST keys only. Put your sk_test_ key here in backend/.env.test.
PAYSTACK_SECRET_KEY=sk_test_replace_me_in_dot_env_test
PAYSTACK_PUBLIC_KEY=pk_test_replace_me_in_dot_env_test
