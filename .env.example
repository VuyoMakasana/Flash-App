# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose credentials
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in the repo root (same folder as docker-compose.yml)
# and fill in real values before running `docker compose up`.
#
# This is read automatically by Docker Compose — it is NOT the same file as
# backend/.env (the Node app's own runtime config), which you still need to
# set up separately per backend/.env.example.
#
# There are no defaults for the password fields on purpose: Postgres/Redis
# will fail to start rather than silently run with a weak, guessable
# password that could end up live in a shared/staging environment.
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=flash_user
POSTGRES_PASSWORD=
POSTGRES_DB=flash_db

REDIS_PASSWORD=
