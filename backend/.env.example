# ═══════════════════════════════════════════════════════════════════
# Flash Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file:  cp .env.example .env
# Fill in every value before starting the server.
# NEVER commit the filled-in .env file to git.
# ═══════════════════════════════════════════════════════════════════

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# production | development | test

# ─── DATABASE ────────────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string (URI)
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Connection pool size. 20 is safe for Supabase free tier (max 60 connections).
# Increase if you upgrade to a paid Supabase plan.
DB_POOL_MAX=20

# ─── AUTH ────────────────────────────────────────────────────────────────────
# Generate a secure secret:  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 64 hex characters. Changing this invalidates ALL existing tokens.
JWT_SECRET=CHANGE_ME_generate_with_command_above

JWT_EXPIRES_IN=15m

# ─── PAYSTACK ────────────────────────────────────────────────────────────────
# Test keys:  dashboard.paystack.com → Settings → API Keys & Webhooks
# Live keys:  switch sk_test_ → sk_live_ and set NODE_ENV=production
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# ─── GOOGLE OAUTH (Sign In) ───────────────────────────────────────────────────
# console.cloud.google.com → Create credentials → OAuth 2.0 Client ID
# Create separate credentials for: Android (user app), iOS (user app),
#   Android (driver app), iOS (driver app)
GOOGLE_CLIENT_ID_USER_ANDROID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_USER_IOS=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_DRIVER_ANDROID=YOUR_DRIVER_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_DRIVER_IOS=YOUR_DRIVER_IOS_CLIENT_ID.apps.googleusercontent.com

# ─── APPLE SIGN IN ───────────────────────────────────────────────────────────
# developer.apple.com → Certificates, IDs & Profiles → Identifiers
# Must match bundle IDs in app.json exactly.
APPLE_CLIENT_ID=co.za.flash.userapp
APPLE_DRIVER_CLIENT_ID=co.za.flash.driverapp

# ─── GOOGLE MAPS ─────────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials
# RESTRICT this key in Google Cloud Console to:
#   - Specific Android package names (co.za.flash.userapp, co.za.flash.driverapp)
#   - Specific iOS bundle IDs
# An unrestricted Maps key can be abused by anyone who decompiles the APK.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ─── ADMIN ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@flash.co.za
# Generate hash:  node -e "require('bcrypt').hash('YOUR_PASSWORD', 12).then(console.log)"
ADMIN_PASSWORD_HASH=$2a$12$REPLACE_WITH_BCRYPT_HASH_OF_YOUR_ADMIN_PASSWORD

# ─── REDIS ───────────────────────────────────────────────────────────────────
# Required for Socket.IO horizontal scaling (multiple server instances).
# Free option: upstash.com → Create Redis database → copy the Redis URL.
# Set to "disabled" only for single-instance development (no horizontal scale).
REDIS_URL=disabled
# REDIS_URL=redis://default:YOUR_PASSWORD@YOUR_HOST.upstash.io:6379

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Mobile apps bypass CORS.
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ─── APP URL ─────────────────────────────────────────────────────────────────
# Your deployed backend URL. Used for Paystack callback redirects.
APP_URL=https://your-backend-domain.onrender.com

# ─── CLOUDINARY ──────────────────────────────────────────────────────────────
# cloudinary.com → Dashboard → copy Cloud name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# ─── EMAIL / SMTP ────────────────────────────────────────────────────────────
# Required for email verification and password reset.
# Gmail setup:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to Account → Security → App Passwords
#   3. Generate an "App Password" for "Mail"
#   4. Use that 16-character password as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM=Flash <noreply@flash.co.za>

# ─── SENTRY ──────────────────────────────────────────────────────────────────
# sentry.io → Project → Settings → Client Keys (DSN)
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID

# ─── PAYFLEX (BNPL — disabled until fully tested) ────────────────────────────
PAYFLEX_API_KEY=placeholder
PAYFLEX_API_URL=https://api.payflex.co.za
PAYFLEX_WEBHOOK_SECRET=YOUR_PAYFLEX_WEBHOOK_SECRET
