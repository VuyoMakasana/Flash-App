# ─────────────────────────────────────────────────────────────────────────────
# Flash Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# How to use this file:
#   1. Copy this file to a new file called .env  (cp .env.example .env)
#   2. Fill in your real values below
#   3. Never commit .env to git — it contains secret keys
#
# PRODUCTION SECURITY REQUIREMENTS:
#   ✓ All REQUIRED variables must contain real, non-placeholder values
#   ✓ JWT_SECRET must be a long random cryptographic string
#   ✓ PAYSTACK keys must use sk_live_* and pk_live_* (not sk_test_)
#   ✓ ADMIN_PASSWORD_HASH must be bcrypt hash (plain ADMIN_PASSWORD not allowed)
#   ✓ DATABASE_URL must be real PostgreSQL connection
#   ✓ AWS credentials must be real if using S3
#   ✓ ALLOWED_ORIGINS must be set to your production domain(s)
# ─────────────────────────────────────────────────────────────────────────────

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3000
# Set to 'production' when deploying to Render, Railway, etc.
# This switches morgan logging to 'tiny' and hides internal error messages.
# CRITICAL: Errors from missing configuration will be logged clearly in production mode.
NODE_ENV=development

# ── DATABASE (CRITICAL - REQUIRED) ────────────────────────────────────────────
# PostgreSQL connection string.
# Local dev: postgresql://flash_user:flash_password@localhost:5432/flash_db
# Render:    copy the "Internal Database URL" from your Render Postgres dashboard
# Supabase:  copy the "Connection string" from your Supabase project settings
# PRODUCTION: Must be real, working database connection - NOT placeholder
DATABASE_URL=postgresql://flash_user:flash_password@localhost:5432/flash_db

# How many database connections to keep open at once.
# 20 is safe for Render Starter. Raise to 50 on Render Standard or Supabase Pro.
DB_POOL_MAX=20

# ── JWT (Authentication Tokens) (CRITICAL - REQUIRED) ─────────────────────────
# Used to sign and verify login tokens. MUST CHANGE THIS before going to production.
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# PRODUCTION: Must be a long (32+ chars) random cryptographic string, NOT placeholder
# DEVELOPMENT: Can use any string, but should still be reasonably random
JWT_SECRET=flashsecretkey2024changethislater
JWT_EXPIRES_IN=30d

# ── PAYSTACK (Payments) ───────────────────────────────────────────────────────
# Flash uses Paystack for all card payments (SA-native, supports ZAR natively).
# Get your keys from: dashboard.paystack.com → Settings → API Keys & Webhooks
#
# TESTING:  use sk_test_... and pk_test_... keys (no real money moves)
# PRODUCTION: use sk_live_... and pk_live_... keys (real payments)
#
# CRITICAL: The backend will reject requests with sk_test_* keys in production
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder

# ── WEBHOOK URL ───────────────────────────────────────────────────────────────
# Where your backend lives. Paystack uses this for redirects after payment.
# Local dev:  http://localhost:3000
# Production: https://your-app.onrender.com
# PRODUCTION: Must be set to your actual domain
APP_URL=http://localhost:3000

# ── REDIS (Optional — for scaling) ───────────────────────────────────────────
# Redis allows Socket.io to work across multiple backend servers.
# Set to 'disabled' for a single server (default for development and small scale).
# Set to redis://localhost:6379 for local Redis.
# Set to your Upstash or Redis Cloud URL for production scaling.
REDIS_URL=disabled

# ── AWS S3 (Driver Document Uploads - PRODUCTION RECOMMENDED) ────────────────
# Drivers upload their KYC documents (ID, license, etc.) to S3.
# 
# DEVELOPMENT: Can use placeholders - document uploads will be simulated locally
# PRODUCTION: Requires real AWS credentials for security and compliance
#
# Get from: AWS Console → IAM → Create Access Key
# CRITICAL: Never use root AWS credentials. Create IAM user with S3-only permissions.
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_REGION=af-south-1
AWS_S3_BUCKET=flash-documents

# ── GOOGLE MAPS ───────────────────────────────────────────────────────────────
# Used for server-side distance calculations (fleet intelligence, radius queries).
# The frontend map keys go into flash-user-app/app.json and flash-driver-app/app.json.
# Get from: console.cloud.google.com → APIs & Services → Credentials
# Optional: Can be left as placeholder if maps features are not critical
GOOGLE_MAPS_API_KEY=placeholder

# ── ADMIN ACCOUNT (CRITICAL) ──────────────────────────────────────────────────
# The admin account is used to approve drivers and view stats.
# These are your admin login credentials — change them before deploying.
ADMIN_EMAIL=admin@flash.co.za

# Hashed admin password (REQUIRED FOR PRODUCTION).
# How to generate: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
# Paste the output here.
#
# PRODUCTION: This MUST be set. Plain text password (ADMIN_PASSWORD) will NOT work.
# DEVELOPMENT: Can leave empty to use ADMIN_PASSWORD plain text (with warning)
ADMIN_PASSWORD_HASH=

# Plain text password (DEVELOPMENT ONLY).
# PRODUCTION: Leave this empty and use ADMIN_PASSWORD_HASH instead
# SECURITY: Using plain text in production is not allowed
ADMIN_PASSWORD=admin123

# ── PAYFLEX (Buy Now Pay Later — optional) ────────────────────────────────────
# Payflex lets users split purchases into 4 instalments.
# Contact Payflex (payflex.co.za) to get merchant API credentials.
# Leave as placeholder to disable Payflex — all other payments still work.
PAYFLEX_API_KEY=placeholder
PAYFLEX_API_URL=https://api.payflex.co.za

# ── CORS SECURITY (PRODUCTION CRITICAL) ────────────────────────────────────────
# Allowed origins for CORS requests (comma-separated).
# Controls which domains can make requests to this API.
#
# DEVELOPMENT: Leave empty to use safe defaults (localhost:3000, 3001, 8081, 19002)
# PRODUCTION: Must be explicitly set to your app domains only
#
# Example for production:
#   ALLOWED_ORIGINS=https://app.flash.co.za,https://driver.flash.co.za
#
# SECURITY: Leaving this empty in production may block legitimate requests
ALLOWED_ORIGINS=

# ── SENTRY (Error Monitoring) ─────────────────────────────────────────────────
# ADDED: Sentry DSN for error monitoring — get this from sentry.io (free tier available)
# Without this, crashes are invisible in production
# Get from: sentry.io → New Project → Node.js → DSN
SENTRY_DSN=
